we cannot use bash anymore, so i had to write a code that will kill all the zombie's cabins for me.

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <signal.h>
#include <unistd.h>

static int to_int(const char *s) {
    int n = 0;
    while (*s >= '0' && *s <= '9') { 
      n = n * 10 + (*s - '0'); s++; 
    }
    return n;
}

static int starts_princess(const char *s) {
    const char *pre = "princess_";
    while (*pre) { 
      if (*s++ != *pre++) {
        return 0; 
      }
    }
    return 1;
}

int main(void) {
    int killed = 0;
    while (killed < 100) {
        for (int pid = 1; pid < 32768; pid++) {
            char path[64], comm[64], state;
            int ppid;

            sprintf(path, "/proc/%d/stat", pid);
            FILE *f = fopen(path, "r");
            if (!f) continue;

            int ok = fscanf(f, "%*d (%63[^)]) %c %d", comm, &state, &ppid);
            fclose(f);
            if (ok != 3) continue;

            if (state != 'Z') continue;
            if (!starts_princess(comm)) continue;
            if (ppid <= 1) continue;

            sprintf(path, "/proc/%d/comm", ppid);
            f = fopen(path, "r");
            if (!f) continue;
            fgets(comm, sizeof(comm), f);
            fclose(f);

            if (strstr(comm, "cabin") != NULL && kill(ppid, SIGTERM) == 0)
                killed++;
        }
        printf("%d\n", killed);
        fflush(stdout);
        sleep(1);
    }
    return 0;
}

